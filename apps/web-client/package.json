{
  "name": "@smashing-cats/web-client",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean:public": "rm -rf public && mkdir -p public",
    "prepare-assets:canvas": "pnpm clean:public && cp -R public-src/common/. public/ && cp -R public-src/canvas/. public/",
    "prepare-assets:phaser": "pnpm clean:public && cp -R public-src/common/. public/ && cp -R public-src/canvas/. public/ && cp -R public-src/phaser/. public/",
    "prepare-assets:full": "pnpm clean:public && cp -R public-src/common/. public/ && cp -R public-src/canvas/. public/ && cp -R public-src/phaser/. public/ && cp -R public-src/three/. public/",
    "dev": "vite --host 0.0.0.0",
    "dev:canvas": "pnpm prepare-assets:canvas && VITE_RENDERER_BUNDLE=canvas vite --host 0.0.0.0",
    "dev:phaser": "pnpm prepare-assets:phaser && VITE_RENDERER_BUNDLE=phaser vite --host 0.0.0.0",
    "dev:full": "pnpm prepare-assets:full && VITE_RENDERER_BUNDLE=all vite --host 0.0.0.0",
    "build": "pnpm prepare-assets:canvas && VITE_RENDERER_BUNDLE=canvas vite build",
    "build:canvas": "pnpm prepare-assets:canvas && VITE_RENDERER_BUNDLE=canvas vite build",
    "build:phaser": "pnpm prepare-assets:phaser && VITE_RENDERER_BUNDLE=phaser vite build",
    "build:full": "pnpm prepare-assets:full && VITE_RENDERER_BUNDLE=all vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "start": "node server.js",
    "assets:generate": "capacitor-assets generate",
    "cap:init": "cap init \"Smashing Cats\" \"com.catemup.smashingcats\" --web-dir=dist",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:sync:canvas": "pnpm build:canvas && cap sync android",
    "cap:sync:phaser": "pnpm build:phaser && cap sync android",
    "cap:sync:full": "pnpm build:full && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/status-bar": "^8.0.2",
    "@smashing-cats/client-netcode": "workspace:*",
    "@smashing-cats/core": "workspace:*",
    "@smashing-cats/i18n": "workspace:*",
    "@smashing-cats/protocol": "workspace:*",
    "phaser": "^4.1.0",
    "three": "^0.184.0",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0"
  }
}
