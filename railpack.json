{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "inputs": [{ "local": true, "include": ["."] }],
      "commands": ["pnpm install --frozen-lockfile"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["pnpm build:server"]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @smashing-cats/server start"
  }
}
